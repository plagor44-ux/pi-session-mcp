{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "vitest.config.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "eval/profiles/**/*.ts",
    "eval/bridge/**/*.ts",
    "eval/recovery/**/*.ts",
    "eval/turn-deadline/**/*.ts",
    "eval/reports/**/*.ts"
  ]
}

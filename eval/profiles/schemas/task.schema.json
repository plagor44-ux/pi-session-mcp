{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^T[1-9]$"
    },
    "title": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "P1",
          "P2",
          "P3",
          "P4"
        ]
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,80}$"
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fixture_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "oracle_kind": {
      "type": "string"
    },
    "task_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "family",
    "profiles",
    "views",
    "allowed_paths",
    "prompt_hash",
    "fixture_hash",
    "oracle_kind",
    "task_hash"
  ],
  "additionalProperties": false,
  "$id": "urn:pi-profile-evaluation:1.0.0:task"
}

{
  "tools": [
    {
      "name": "pi_capabilities_get",
      "description": "List configured workspace and execution-profile aliases. This reports configured intent, not provider or runtime availability. Call once at the start of a run.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "server": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "const": "pi-session-mcp"
              },
              "version": {
                "type": "string",
                "const": "0.11.5"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "configuration": {
            "type": "object",
            "properties": {
              "fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "reloadPolicy": {
                "type": "string",
                "const": "restart-required"
              }
            },
            "required": [
              "fingerprint",
              "reloadPolicy"
            ],
            "additionalProperties": false
          },
          "events": {
            "type": "object",
            "properties": {
              "delivery": {
                "type": "string",
                "enum": [
                  "spool",
                  "off"
                ]
              }
            },
            "required": [
              "delivery"
            ],
            "additionalProperties": false
          },
          "workspaces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "alias": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "unset",
                    "host",
                    "container",
                    "read-only"
                  ]
                }
              },
              "required": [
                "alias",
                "mode"
              ],
              "additionalProperties": false
            }
          },
          "executionProfiles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "alias": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "default": {
                  "type": "boolean"
                },
                "permissionProfile": {
                  "type": "string",
                  "enum": [
                    "read-only",
                    "coding"
                  ]
                },
                "provider": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "thinkingLevel": {
                  "type": "string",
                  "enum": [
                    "off",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "extensions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "grantedExtensionTools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "shell": {
                  "type": "string",
                  "enum": [
                    "none",
                    "sandboxed"
                  ]
                },
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  }
                }
              },
              "required": [
                "alias",
                "default",
                "permissionProfile",
                "provider",
                "model",
                "thinkingLevel",
                "extensions",
                "grantedExtensionTools",
                "shell",
                "skills"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ok",
          "server",
          "configuration",
          "events",
          "workspaces",
          "executionProfiles"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pi_session_start",
      "description": "Start a managed embedded Pi session for a configured workspace alias.",

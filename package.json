{
  "name": "pi-session-mcp",
  "version": "0.14.0",
  "description": "Local stdio MCP server for controlled Pi coding-agent sessions",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pi",
    "coding-agent",
    "stdio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plagor44-ux/pi-session-mcp.git"
  },
  "homepage": "https://github.com/plagor44-ux/pi-session-mcp#readme",
  "bugs": {
    "url": "https://github.com/plagor44-ux/pi-session-mcp/issues"
  },
  "type": "module",
  "bin": {
    "pi-session-mcp": "dist/main.js",
    "pi-session-mcp-setup": "dist/setup-main.js",
    "pi-session-mcp-wake": "dist/wake-main.js",
    "pi-session-mcp-doctor": "scripts/doctor.mjs"
  },
  "files": [
    "dist/",
    ".pi-session-mcp-cli/",
    "scripts/doctor.mjs",
    "scripts/isolation-acceptance.mjs",
    "scripts/isolation-probe.cjs",
    "pi-session-mcp.example.json",
    "skills/",
    "docs/",
    "!docs/superpowers/",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node dist/setup-main.js",
    "start": "node dist/main.js",
    "inspect": "mcp-inspector node dist/main.js",
    "prepack": "npm run build && npm run build:cli",
    "eval:profiles": "node scripts/profile-evaluation.mjs",
    "eval:extensions": "node scripts/extension-ablation.mjs",
    "eval:schemas": "tsc -p tsconfig.eval.json && node scripts/profile-evaluation-schemas.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@earendil-works/pi-telemetry": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.11.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}

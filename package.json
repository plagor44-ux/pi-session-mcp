{
  "name": "pi-session-mcp",
  "version": "0.6.1",
  "description": "Local stdio MCP server for controlled Pi coding-agent sessions",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pi",
    "coding-agent",
    "stdio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plagor44-ux/pi-session-mcp.git"
  },
  "homepage": "https://github.com/plagor44-ux/pi-session-mcp#readme",
  "bugs": {
    "url": "https://github.com/plagor44-ux/pi-session-mcp/issues"
  },
  "type": "module",
  "bin": {
    "pi-session-mcp": "dist/main.js",
    "pi-session-mcp-setup": "dist/setup-main.js",
    "pi-session-mcp-doctor": "scripts/doctor.mjs"
  },
  "files": [
    "dist/",
    ".pi-session-mcp-cli/",
    "scripts/doctor.mjs",
    "pi-session-mcp.example.json",
    "docs/",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node dist/setup-main.js",
    "start": "node dist/main.js",
    "inspect": "mcp-inspector node dist/main.js",
    "prepack": "npm run build && npm run build:cli"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.10.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
